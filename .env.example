# Token from @BotFather
BOT_TOKEN=123456789:replace-me

# Comma-separated Telegram user ids that can use /admin (get yours from @userinfobot)
ADMIN_IDS=

# SQLite database file (relative to the project folder)
DB_PATH=data/wordchain.db

# Optional: require a channel subscription. The bot must be an admin of the channel.
REQUIRED_CHANNEL=
# Needed only for private channels (invite link); public @channels build the link automatically
REQUIRED_CHANNEL_LINK=

# Game tuning
PVP_TURN_SECONDS=45
MAX_STRIKES=3
MAX_HINTS=2

# Uzbek translations in the game summary (cached in the database; 0 to turn off)
TRANSLATE=1
